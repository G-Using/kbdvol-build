#!/bin/sh
# KbdVol 安装后处理。
# 目标：保证设置里能稳定出现「键盘音量」这一项。
# 覆盖安装时可能留下上一版的 dylib / RootHide 的 patch 副本，
# PreferenceLoader 读到坏入口就会**静默不显示菜单项**（无任何报错），
# 所以这里把它们清掉/改名，保证下次加载的是本次的干净版本。
# 注意：不 set -e，所有动作吞错误，最后无条件 exit 0，绝不让安装失败。

JB=""
for p in /var/jb /private/preboot ; do
    if [ -d "$p" ] && [ -d "$p/Library/PreferenceLoader" ]; then JB="$p"; break; fi
done
[ -z "$JB" ] && JB="/var/jb"

# 1) RootHide 生成的 *.dylib.roothidepatch 会让新 dylib 不被采用 —— 改名作废（可回滚）
for f in \
    "$JB/usr/lib/TweakInject/KbdVol.dylib.roothidepatch" \
    "$JB/Library/MobileSubstrate/DynamicLibraries/KbdVol.dylib.roothidepatch"
do
    [ -e "$f" ] && mv "$f" "$f.old" 2>/dev/null
done

# 2) 清掉 PreferenceLoader 可能缓存的本插件状态
rm -f "$JB/Library/PreferenceLoader/Preferences/KbdVolPrefs.plist.stale" 2>/dev/null
rm -f /var/mobile/Library/Preferences/com.gusing.kbdvol.plist 2>/dev/null

exit 0
