<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- 标题组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupSpecifier</string>
            <key>footerText</key>
            <string>独立控制键盘按键音音量，此滑块不影响系统音量（侧边按钮），也不影响铃声/媒体音量。
• 滑块 0% = 完全静音（无需拨静音拨片）
• 滑块 100% = 最大音量</string>
            <key>label</key>
            <string>键盘按键音</string>
        </dict>

        <!-- 总开关 -->
        <dict>
            <key>cell</key>
            <string>PSToggleSwitchSpecifier</string>
            <key>defaults</key>
            <string>com.gusing.kbdvol</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>启用独立音量控制</string>
            <key>default</key>
            <true/>
        </dict>

        <!-- 音量滑块 -->
        <dict>
            <key>cell</key>
            <string>PSSliderSpecifier</string>
            <key>defaults</key>
            <string>com.gusing.kbdvol</string>
            <key>key</key>
            <string>volume</string>
            <key>label</key>
            <string>按键音量</string>
            <key>defaultValue</key>
            <real>1.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>1.0</real>
            <key>showValue</key>
            <true/>
        </dict>

        <!-- 诊断组 -->
        <dict>
            <key>cell</key>
            <string>PSGroupSpecifier</string>
            <key>label</key>
            <string>诊断</string>
        </dict>

        <!-- 诊断按钮 -->
        <dict>
            <key>action</key>
            <string>showDiag</string>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>title</key>
            <string>查看插件状态</string>
        </dict>
    </array>
</dict>
</plist>
